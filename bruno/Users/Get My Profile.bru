meta {
  name: Get My Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("is the logged-in user", function () {
    expect(res.body.email).to.equal(bru.getVar("userEmail"));
  });
}

docs {
  Needs `token` from Login.
}
