meta {
  name: Signup - Duplicate Email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

body:json {
  {
    "name": "Duplicate",
    "email": "{{adminEmail}}",
    "password": "{{userPassword}}"
  }
}

assert {
  res.status: eq 409
}

docs {
  Uses the seeded admin's email, which always exists.
}
