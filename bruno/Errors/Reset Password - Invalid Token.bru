meta {
  name: Reset Password - Invalid Token
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-real-reset-token",
    "newPassword": "brandNewSecret1"
  }
}

assert {
  res.status: eq 400
  res.body.message: eq Invalid or expired password reset token
}
