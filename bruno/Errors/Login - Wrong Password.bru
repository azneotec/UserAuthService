meta {
  name: Login - Wrong Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "definitely-wrong"
  }
}

assert {
  res.status: eq 401
  res.body.message: eq Invalid email or password
}

docs {
  An unknown email returns the identical 401, so login can't be used to enumerate accounts.
}
