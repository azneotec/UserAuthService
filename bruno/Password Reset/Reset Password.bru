meta {
  name: Reset Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{userPassword}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Manual step: needs the token from the reset email (or the `[EMAIL STUB]` log line when
  `PASSWORD_RESET_DELIVERY=log`). Put it in the `resetToken` environment variable first, otherwise this returns 400
  and fails in a full collection run. A token is single-use and expires after 15 minutes.
}
