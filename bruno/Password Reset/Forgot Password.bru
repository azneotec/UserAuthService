meta {
  name: Forgot Password
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Always 200 with the same message, whether or not the email is registered.

  The reset token travels by email: with the default `password-reset.delivery=kafka` it goes through
  NotificationService; with `PASSWORD_RESET_DELIVERY=log` the link is printed in the service log
  (`[EMAIL STUB] Password reset link for ...`). Copy the `token` query value into the `resetToken`
  environment variable, then send Reset Password.
}
