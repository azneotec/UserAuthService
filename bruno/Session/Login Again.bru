meta {
  name: Login Again
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
  }
}

assert {
  res.status: eq 200
}

docs {
  Fresh token for the Signup user. Needed after Promote User to Admin, which revokes their sessions.
}
