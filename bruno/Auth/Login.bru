meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
    bru.setVar("userId", res.body.user.id);
  }
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
}

tests {
  test("returns a token and the user", function () {
    expect(res.body.token).to.be.a("string").and.not.empty;
    expect(res.body.expiresAt).to.be.a("string");
    expect(res.body.user.email).to.equal(bru.getVar("userEmail"));
  });
}

docs {
  Logs in as the user created by Signup and stores the JWT as `token`. Run Signup first.
}
