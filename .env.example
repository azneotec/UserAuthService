# Copy to .env (gitignored) and adjust. Read by `./mvnw spring-boot:run`, `make run` and `java -jar`.
# Unquoted values only. Anything also set as a real environment variable takes precedence.
# Defaults shown; remove a line to fall back to application.properties.

DB_HOST=localhost
# 3306 = host MySQL; 3307 = the MySQL started by the root `make up` (docker-compose.yml)
DB_PORT=3306
DB_NAME=user_auth_service
DB_USERNAME=root
DB_PASSWORD=password

# Generate with: openssl rand -base64 32 (must decode to >= 32 bytes). Unset uses the dev key.
#JWT_SECRET=
#JWT_EXPIRATION=24h

# 9001 for a second instance
#SERVER_PORT=8001
